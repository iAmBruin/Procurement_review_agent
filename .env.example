# ===== 数据库连接（本机 MySQL80）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=procurement_agent

# ===== RAGFlow 接入（阶段6，联调时填写）=====
# RAGFlow 服务地址（本机 Docker 部署默认 80 端口）
RAGFLOW_BASE_URL=http://localhost
# RAGFlow API Key（登录 RAGFlow 后在 头像 -> API Key 中创建）
RAGFLOW_API_KEY=
# 知识库名称（首次运行脚本时自动创建）
RAGFLOW_DATASET=procurement_rules

# ===== Dify 接入（阶段8，联调时填写）=====
DIFY_BASE_URL=http://localhost/v1
DIFY_APP_API_KEY=

# ===== MCP Server =====
# stdio（默认，供本地调试）或 streamable-http（供 Dify 连接）
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8911
